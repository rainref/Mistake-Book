page{background:#f5f7f4;color:#20382c;font-family:-apple-system,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}view,text,button,input,textarea{box-sizing:border-box}.page{padding:32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:22rpx;letter-spacing:4rpx;color:#718176;margin-bottom:12rpx}.title{font-size:46rpx;font-weight:700;line-height:1.4;margin-bottom:16rpx}.subtitle,.muted{color:#7b867e;font-size:25rpx}.hero{padding:32rpx 0 40rpx}.card{background:white;border:1rpx solid #e5ebe5;border-radius:24rpx;padding:30rpx;margin-bottom:24rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.grow{flex:1;min-width:0}.section-title{font-size:32rpx;font-weight:600;margin:28rpx 0 20rpx}.metric{font-size:52rpx;font-weight:700;line-height:1.2}.metrics{display:flex;gap:16rpx;margin-bottom:28rpx}.metrics .card{flex:1;margin:0;padding:26rpx 18rpx}.metrics .muted{font-size:22rpx;margin-top:12rpx}button{font-size:28rpx;font-weight:500;border-radius:16rpx;margin:0;line-height:1.5;padding:22rpx 28rpx;background:#eaf0eb;color:#24654b}button::after{border:none}button.primary{background:#24654b;color:white}button.small{font-size:24rpx;padding:14rpx 22rpx}button.danger{background:#fff0ee;color:#ab4842}button[disabled]{opacity:.5}.actions{display:flex;gap:16rpx;margin-top:24rpx}.actions button{flex:1}.label{font-size:25rpx;font-weight:600;margin:24rpx 0 12rpx;display:block}input,textarea,.picker{background:#f5f7f4;border:1rpx solid #e3e9e2;border-radius:14rpx;width:100%;padding:20rpx 22rpx;font-size:28rpx;min-height:86rpx}input{height:90rpx}textarea{min-height:180rpx;line-height:1.7}.textarea-lg{min-height:280rpx}.pill{display:inline-block;background:#edf3ec;color:#42664a;padding:6rpx 16rpx;border-radius:10rpx;font-size:22rpx;margin:6rpx 10rpx 6rpx 0}.pill.gold{background:#fbf2df;color:#927334}.empty{padding:60rpx 28rpx;text-align:center;color:#7b867e}.error{background:#fff0ee;color:#a64c43;border-radius:16rpx;padding:22rpx;margin-bottom:24rpx;white-space:pre-wrap}.loading{text-align:center;padding:30rpx;color:#7b867e}.book-icon{width:84rpx;height:100rpx;background:#dfeadb;border-radius:8rpx 18rpx 18rpx 8rpx;border-left:8rpx solid #719674;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:600;margin-right:10rpx}.book-name{font-size:34rpx;font-weight:600}.question{white-space:pre-wrap;word-break:break-word;font-size:29rpx;line-height:1.8}.preview{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;white-space:pre-wrap}.photo{width:100%;border-radius:16rpx;margin:18rpx 0;background:#eef2ed}.bar{height:14rpx;border-radius:10rpx;background:#edf1eb;overflow:hidden;margin:14rpx 0 26rpx}.bar-fill{height:100%;background:#80a48a;border-radius:10rpx}.link{color:#24654b;text-align:center;padding:22rpx}.divider{height:1rpx;background:#e9ede7;margin:24rpx 0}.notice{font-size:24rpx;color:#7b867e;margin-top:18rpx;white-space:pre-wrap}.count{font-size:24rpx;color:#7b867e}.filter-row{display:flex;gap:12rpx;margin:20rpx 0}.filter-row .picker{padding:14rpx;font-size:24rpx;min-height:0}.filter-row picker,.filter-row input{flex:1;min-width:0}.selected{background:#24654b!important;color:white!important}.chart{height:230rpx;display:flex;align-items:flex-end;justify-content:space-around;gap:12rpx;margin-top:24rpx}.chart-col{flex:1;text-align:center;font-size:20rpx;color:#7b867e}.chart-stick{width:30rpx;background:#82a18a;min-height:3rpx;margin:8rpx auto;border-radius:8rpx 8rpx 0 0}