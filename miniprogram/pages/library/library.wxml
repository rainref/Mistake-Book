<view class="page">
  <mode-banner />
  <view class="hero row">
    <view>
      <view class="eyebrow">MY NOTEBOOK</view>
      <view class="title">我的错题库</view>
    </view><button class="primary small" bindtap="capture">＋ 录题</button>
  </view>
  <input placeholder="搜索题目内容" value="{{query}}" data-field="query" bindinput="input" bindconfirm="search" confirm-type="search" />
  <view class="filter-row">
    <picker range="{{subjects}}" value="{{subjectIndex}}" data-field="subjectIndex" bindchange="pick">
      <view class="picker">{{subjects[subjectIndex]}} ▾</view>
    </picker>
    <picker range="{{states}}" value="{{stateIndex}}" data-field="stateIndex" bindchange="pick">
      <view class="picker">{{states[stateIndex]}} ▾</view>
    </picker>
  </view>
  <view class="card">
    <view class="filter-row"><input value="{{chapter}}" placeholder="章节（完整名称）" data-field="chapter" bindinput="input" /><input value="{{knowledgePoint}}" placeholder="知识点（完整标签）" data-field="knowledgePoint" bindinput="input" /></view>
    <view class="actions"><button class="small primary" bindtap="search">筛选错题</button><button class="small" bindtap="clear">重置</button></view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}
    <view class="link" bindtap="search">重试</view>
  </view>
  <question-card wx:for="{{items}}" wx:key="_id" item="{{item}}" bind:open="open" />
  <view wx:if="{{loading}}" class="loading">正在加载…</view>
  <view wx:elif="{{!items.length && !error}}" class="empty">没有找到符合条件的错题。<view></view>试试调整筛选条件，或录入一道新题。</view>
  <view wx:elif="{{!hasMore && items.length}}" class="loading">已经到底了</view>
</view>